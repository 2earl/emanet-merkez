{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emanet-merkez",
  // The 2earl Cloudflare account. An identifier, not a credential; deploys need only the token.
  "account_id": "304c2b77d734c688c8309d5a535f561a",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_als"],

  // Served at https://merkez.emanet.dev: the custom domain is 2earl/emanet-core's
  // infra/worker.tf, attached once this Worker exists.
  "workers_dev": false,
  "preview_urls": false,

  // Logs, traces and Issues in Cloudflare (emanet-core docs/DESIGN.md §12). The app logs one
  // structured line per request: route pattern, status, duration. Never a plate, an address or a
  // person; invocation logs (full URLs) stay off.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
    "issues": { "enabled": true },
  },

  "vars": {
    "SITE_ORIGIN": "https://merkez.emanet.dev",
    "AUTHORIZATION_SERVER": "https://login.2earl.com",
  },

  "secrets": {
    "required": [
      // HMAC key for session and sign-in cookies (only HMACs are stored).
      "SESSION_PEPPER",
    ],
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },

  "services": [
    // Token exchange and validation for sign-in, never over the public Internet.
    { "binding": "AUTH_SERVER", "service": "login" },
    // Who is 2earl staff, and in which role, read on every request (login DESIGN §4.29).
    { "binding": "STAFF", "service": "login", "entrypoint": "StaffDirectory" },
    // Emanet's data and rules, as staff may change them (emanet-core).
    { "binding": "CORE", "service": "emanet-core", "entrypoint": "ControlApi" },
  ],

  "ratelimits": [
    {
      "name": "FORM_RATE_LIMITER",
      "namespace_id": "3001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],

  // Agents' photos and reports, read by staff before confirming a delivery (written by Emanet
  // Saha). EU jurisdiction, like the databases.
  // Agents' evidence, and companies' onboarding documents: shown to staff, and deleted when the
  // core says a file must go (a request, a deleted account, the end of its retention).
  "r2_buckets": [
    { "binding": "EVIDENCE", "bucket_name": "emanet-evidence", "jurisdiction": "eu" },
    { "binding": "DOCUMENTS", "bucket_name": "emanet-documents", "jurisdiction": "eu" },
  ],

  // Sessions and sign-in transactions only; everything else is in emanet-core.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emanet-merkez",
      "database_id": "92cd704a-5c54-47b7-8bef-7238c75fc122",
      "migrations_dir": "migrations",
    },
  ],

  // Every ten minutes: delete the files the core has queued for erasure (src/index.ts).
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
}
